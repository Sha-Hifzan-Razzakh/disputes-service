# Copy to .env for local runs. Every setting is APP_<NAME>; see app/bootstrap/settings.py and docs/runtime.md.
APP_ENV=dev

# Database + checkpointer (same Postgres)
APP_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/disputes
APP_DB_POOL_SIZE=5
APP_CHECKPOINT_POOL_MAX=4
# dev/test only; staging/prod must set false and run the checkpointer setup at deploy
APP_CHECKPOINT_AUTO_SETUP=true
APP_CHECKPOINT_RETENTION_DAYS=90
# Required in every environment that runs the app (read by langgraph at import time)
LANGGRAPH_STRICT_MSGPACK=true

# Auth (must be overridden outside dev/test)
APP_JWT_SECRET=dev-only-secret-change-me-in-every-env

# Model: rules (deterministic, default) or anthropic
APP_MODEL_PROVIDER=rules
# APP_ANTHROPIC_API_KEY=
APP_MODEL_NAME=claude-sonnet-4-5
APP_MODEL_TIMEOUT_S=20
APP_MODEL_MAX_RETRIES=2
APP_MODEL_REQUESTS_PER_SECOND=2

# Outbound HTTP and tools (MCP servers, M3)
APP_HTTP_TIMEOUT_S=10
APP_TOOL_TIMEOUT_S=4
APP_TOOL_MAX_ATTEMPTS=3
# Kill switch: false = approved actions end EXECUTION_FAILED without calling payments / network
APP_TOOLS_ENABLED=false
APP_MCP_PAYMENTS_URL=http://localhost:8101/mcp
APP_MCP_NETWORK_URL=http://localhost:8102/mcp

# Retrieval and evidence
APP_RETRIEVAL_TOP_K=5
APP_MIN_EVIDENCE_SCORE=0.12
APP_MAX_RETRIEVAL_ATTEMPTS=2
APP_MAX_REFINE_ATTEMPTS=1

# Run limits
APP_RUN_TIMEOUT_S=30
APP_RECURSION_LIMIT=40
APP_MAX_CONCURRENCY=4

# Approvals
APP_APPROVAL_TTL_HOURS=72
APP_URGENT_WINDOW_HOURS=48
APP_APPROVAL_DEADLINE_MARGIN_HOURS=24
